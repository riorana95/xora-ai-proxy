# Xora AI Proxy — Environment Variables
#
# Three providers are supported:
#   1. Google Gemini Developer API — free tier available for development
#   2. Cloudflare Workers AI — FREE (10k neurons/day, no credit card)
#   3. Z.ai — paid (requires credits)
#
# Pick one. Set AI_PROVIDER explicitly to force that provider. If unset,
# the proxy uses Gemini first, then Cloudflare, then Z.ai.

# ============================================================
# OPTION A — Google Gemini Developer API (RECOMMENDED FOR XORA INTERVIEW)
# ============================================================
# Gemini 2.5 Flash is fast, supports structured JSON, and has a free
# development tier. The free tier may use prompts to improve Google products,
# so use a paid tier before sending production user data such as resumes.
# Create a key: https://aistudio.google.com/apikey

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL= gemini-2.5-flash

# Voice Interview (Gemini Live API)
# The browser receives a short-lived, one-use token from the proxy. Do not add
# this API key to the Angular frontend or a Vercel public environment variable.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ============================================================
# OPTION B — Cloudflare Workers AI (FREE FALLBACK)
# ============================================================
# Free tier: 10,000 neurons per day at no cost. No credit card needed.
# Get these at https://dash.cloudflare.com → My Profile → API Tokens

# AI_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Best free model for interview QA / general coaching.
# Use this unless you specifically want a coding-specialized model.
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Alternative free options:
#   @cf/qwen/qwen2.5-coder-32b-instruct      (best for Java/Spring Boot coding interviews)
#   @cf/moonshotai/kimi-k2.6                  (strong reasoning)
#   @cf/meta/llama-3.1-8b-instruct            (faster / lighter)

# ============================================================
# OPTION C — Z.ai (PAID, needs credits)
# ============================================================
# Only set these if you want to use Z.ai instead of Gemini or Cloudflare.
# Your account must have credits or calls will fail with 429.
#
# AI_PROVIDER=zai
# ZAI_API_KEY=your_zai_api_key_here
# (optional) ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============================================================
# Other settings
# ============================================================

# Port the proxy listens on (default 3001)
PORT=3001

# URL of your Xora Spring Boot backend, if you want the proxy to
# validate JWTs against it. Leave empty to skip auth.
CORESTACK_API_URL=https://xoraapi.duckdns.org
